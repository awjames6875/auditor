# The ODMHSAS exit summary and anything derived from it.
# It contains a consumer identifier. It never enters this repo
# in any form — not committed, not attached, not screenshotted.
*Exit*Summary*
*exit*summary*
*Safe?Harbor*8-13-26*
*findings*letter*
*Findings*Letter*

# State/agency documents in any office format. Deny the shape,
# not just the filename, so a rename cannot slip one through.
*.docx
*.doc
*.odt
*.rtf
*.xlsx
*.xls
*.pdf

# Local-only denylist of literal strings check.py screens for.
# Kept OUT of the repo on purpose: publishing the denylist would
# publish the very identifiers it exists to suppress.
# check.py ships SHA-256 hashes instead — see check.py.
.denylist.local

# Session and tooling artifacts. These accumulate transcripts
# and tool output that were never reviewed for publication.
tool-results/
.claude/
tasks/

# Not in the repo by decision — COMP_12_HANDOFF.md:26
CODEX_REVIEW_PROMPT.md

# OS / editor noise
Thumbs.db
desktop.ini
.DS_Store
*.swp
*~

# Auto-generated claude-mem stubs (169 bytes, no content).
# auditor/reference/CLAUDE.md would ship a stray file inside the
# drop-in folder, breaking the "exactly five things" hard gate.
CLAUDE.md
**/CLAUDE.md

# Internal competition strategy and post-mortems. Adam's own notes on
# how these comps are judged and what previous entries got wrong.
# Never public -- this repo is a competition ENTRY, not the playbook
# used to build it.
_competition_history/

# Productization work. Lives beside the entry, never inside it -- a
# competition submission should not ship the business plan behind it.
_product/

# Local archive of the auditor folder. The folder itself is the
# deliverable; a zip of it in the repo root is clutter a judge has to
# step over.
auditor.zip
